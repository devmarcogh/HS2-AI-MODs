// ============================================================================
// ClothSimCompute.compute — GPU xPBD cloth simulation (Optimized)
//
// Mejoras implementadas:
// - Gradiente analítico integrado con el muestreo trilineal (SDFDistanceAndGradient).
// - Reduce las lecturas de VRAM de 14 a 8 por evaluación de colisión.
// - Elimina la función costosa de diferencias centrales.
// ============================================================================

#pragma kernel ClothPredict
#pragma kernel ClothSolveEdges
#pragma kernel ClothSolveBends
#pragma kernel ClothSolveCollision
#pragma kernel ClothCommit

// ─── Structs ────────────────────────────────────────────────────

struct ColliderData
{
    float cx, cy, cz;
    float radius;
    int   isCapsule;
    float p1x, p1y, p1z;
    float vx, vy, vz;
    float vDotV;
    int   magneticMode;
    float magneticStrength;
    float magneticRange;
};

// ─── Buffers ────────────────────────────────────────────────────

RWStructuredBuffer<float3> _Positions;
RWStructuredBuffer<float3> _Velocities;
RWStructuredBuffer<float3> _PredPositions;
StructuredBuffer<float>    _InvMass;
StructuredBuffer<int>      _IsPinned;
StructuredBuffer<int2>     _EdgePairs;
StructuredBuffer<float>    _EdgeRestLen;
StructuredBuffer<int2>     _BendPairs;
StructuredBuffer<float>    _BendRestLen;
StructuredBuffer<ColliderData> _Colliders;
StructuredBuffer<float>    _SDFData;

// ─── Uniforms ───────────────────────────────────────────────────

int   _VertCount;
float _Gravity;
float _Dt;
float _TildedCompliance;
float _BendCompliance;
float _PressScale;
int   _GroupOffset;
int   _GroupCount;
int   _ColCount;
float _Thickness;
float _InvDt;
float _Damp;
float _MaxSpeed;
float _FrictionZone;
int   _UseSDF;
float _SDFOriginX, _SDFOriginY, _SDFOriginZ;
int   _SDFResX, _SDFResY, _SDFResZ;
float _SDFCellSize;
float _SDFInvCellSize;
float _SDFMaxDist;

// ─── SDF Optimized Helpers ──────────────────────────────────────

// Retorna la distancia y el gradiente analítico en una sola lectura trilineal (8 taps)
void SDFDistanceAndGradient(float3 wp, out float dist, out float3 grad)
{
    float fx = (wp.x - _SDFOriginX) * _SDFInvCellSize;
    float fy = (wp.y - _SDFOriginY) * _SDFInvCellSize;
    float fz = (wp.z - _SDFOriginZ) * _SDFInvCellSize;

    // Edge clamp (medio voxel de margen para evitar out-of-bounds)
    fx = clamp(fx, 0.5, (float)_SDFResX - 1.5);
    fy = clamp(fy, 0.5, (float)_SDFResY - 1.5);
    fz = clamp(fz, 0.5, (float)_SDFResZ - 1.5);

    int ix = (int)floor(fx - 0.5);
    int iy = (int)floor(fy - 0.5);
    int iz = (int)floor(fz - 0.5);

    float fracX = fx - ix - 0.5;
    float fracY = fy - iy - 0.5;
    float fracZ = fz - iz - 0.5;

    int sXY = _SDFResX * _SDFResY;

    // 8 lecturas (único acceso a memoria)
    float c000 = _SDFData[ iz      * sXY + iy       * _SDFResX + ix    ];
    float c100 = _SDFData[ iz      * sXY + iy       * _SDFResX + ix + 1];
    float c010 = _SDFData[ iz      * sXY + (iy + 1) * _SDFResX + ix    ];
    float c110 = _SDFData[ iz      * sXY + (iy + 1) * _SDFResX + ix + 1];
    float c001 = _SDFData[(iz + 1) * sXY + iy       * _SDFResX + ix    ];
    float c101 = _SDFData[(iz + 1) * sXY + iy       * _SDFResX + ix + 1];
    float c011 = _SDFData[(iz + 1) * sXY + (iy + 1) * _SDFResX + ix    ];
    float c111 = _SDFData[(iz + 1) * sXY + (iy + 1) * _SDFResX + ix + 1];

    // Distancia Trilineal
    float c00 = lerp(c000, c100, fracX);
    float c10 = lerp(c010, c110, fracX);
    float c01 = lerp(c001, c101, fracX);
    float c11 = lerp(c011, c111, fracX);
    float c0  = lerp(c00,  c10,  fracY);
    float c1  = lerp(c01,  c11,  fracY);
    dist = lerp(c0, c1, fracZ);

    // Gradiente Analítico Directo (Derivadas parciales exactas de la interpolación)
    float invH = _SDFInvCellSize;
    grad.x = invH * (
        (1.0 - fracY) * (1.0 - fracZ) * (c100 - c000) + fracY * (1.0 - fracZ) * (c110 - c010) +
        (1.0 - fracY) * fracZ * (c101 - c001) + fracY * fracZ * (c111 - c011));
        
    grad.y = invH * (
        (1.0 - fracX) * (1.0 - fracZ) * (c010 - c000) + fracX * (1.0 - fracZ) * (c110 - c100) +
        (1.0 - fracX) * fracZ * (c011 - c001) + fracX * fracZ * (c111 - c101));
        
    grad.z = invH * (
        (1.0 - fracX) * (1.0 - fracY) * (c001 - c000) + fracX * (1.0 - fracY) * (c101 - c100) +
        (1.0 - fracX) * fracY * (c011 - c010) + fracX * fracY * (c111 - c110));
}

// ─── Kernel 1: Predict ──────────────────────────────────────────

[numthreads(256, 1, 1)]
void ClothPredict(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _VertCount) return;

    float3 pos = _Positions[i];
    float invM = _InvMass[i];
    if (invM <= 0.0)
    {
        _PredPositions[i] = pos;
        return;
    }

    float3 vel = _Velocities[i];
    vel.y += _Gravity * _Dt;
    _Velocities[i] = vel;
    _PredPositions[i] = pos + vel * _Dt;
}

// ─── Kernel 2: Solve Edges ──────────────────────────────────────

[numthreads(256, 1, 1)]
void ClothSolveEdges(uint3 id : SV_DispatchThreadID)
{
    int eidx = (int)id.x;
    if (eidx >= _GroupCount) return;

    int bufIdx = _GroupOffset + eidx;
    int2 edge = _EdgePairs[bufIdx];
    int i = edge.x, j = edge.y;

    float wi = (_IsPinned[i] != 0) ? 0.0 : _InvMass[i];
    float wj = (_IsPinned[j] != 0) ? 0.0 : _InvMass[j];
    if (wi == 0.0 && wj == 0.0) return;
    
    float wSum = wi + wj + _TildedCompliance;
    if (wSum < 1e-10) return;

    float3 pi = _PredPositions[i];
    float3 pj = _PredPositions[j];
    float3 d  = pi - pj;
    float distSq = dot(d, d);
    if (distSq < 1e-14) return;

    float dist = sqrt(distSq);
    float C = dist - _EdgeRestLen[bufIdx] * _PressScale;
    float3 corr = d * (1.0 / dist) * (-C / wSum);
    
    if (_IsPinned[i] == 0) _PredPositions[i] = pi + wi * corr;
    if (_IsPinned[j] == 0) _PredPositions[j] = pj - wj * corr;
}

// ─── Kernel 3: Solve Bends ──────────────────────────────────────

[numthreads(256, 1, 1)]
void ClothSolveBends(uint3 id : SV_DispatchThreadID)
{
    int bidx = (int)id.x;
    if (bidx >= _GroupCount) return;

    int bufIdx = _GroupOffset + bidx;
    int2 bp = _BendPairs[bufIdx];
    int i = bp.x, j = bp.y;

    float wi = (_IsPinned[i] != 0) ? 0.0 : _InvMass[i];
    float wj = (_IsPinned[j] != 0) ? 0.0 : _InvMass[j];
    if (wi == 0.0 && wj == 0.0) return;
    
    float wSum = wi + wj + _BendCompliance;
    if (wSum < 1e-10) return;

    float3 pi = _PredPositions[i];
    float3 pj = _PredPositions[j];
    float3 d  = pi - pj;
    float distSq = dot(d, d);
    if (distSq < 1e-14) return;

    float dist = sqrt(distSq);
    float C = dist - _BendRestLen[bufIdx];
    float3 corr = d * (1.0 / dist) * (-C / wSum);
    
    if (_IsPinned[i] == 0) _PredPositions[i] = pi + wi * corr;
    if (_IsPinned[j] == 0) _PredPositions[j] = pj - wj * corr;
}

// ─── Kernel 4: Collision ────────────────────────────────────────

[numthreads(256, 1, 1)]
void ClothSolveCollision(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _VertCount) return;
    if (_InvMass[i] <= 0.0) return;

    float3 p = _PredPositions[i];
    
    // ── Capsule / sphere colliders ──
    for (int c = 0; c < _ColCount; c++)
    {
        ColliderData col = _Colliders[c];
        float3 closest;
        if (col.isCapsule == 0)
        {
            closest = float3(col.cx, col.cy, col.cz);
        }
        else
        {
            float3 w = p - float3(col.p1x, col.p1y, col.p1z);
            float3 v = float3(col.vx, col.vy, col.vz);
            float t = (col.vDotV > 1e-8) ? saturate(dot(w, v) / col.vDotV) : 0.0;
            closest = float3(col.p1x, col.p1y, col.p1z) + t * v;
        }

        float3 delta  = p - closest;
        float  distSq = dot(delta, delta);
        float  dist   = sqrt(max(distSq, 1e-12));
        float  minSep = col.radius + _Thickness;

        float3 normal = (dist > 1e-6) ? (delta / dist) : float3(0, 1, 0);

        if (col.magneticMode == 1) // Attract
        {
            if (dist < col.magneticRange)
            {
                float3 onSurface = closest + normal * minSep;
                float blend = (dist < minSep) ? 1.0 : saturate(col.magneticStrength);
                p = lerp(p, onSurface, blend);
            }
        }
        else if (col.magneticMode == 0) // Repel
        {
            if (distSq < minSep * minSep)
                p = closest + normal * minSep;
        }
    }

    // ── SDF body collision ──
    if (_UseSDF != 0)
    {
        float sdfDist;
        float3 grad;
        SDFDistanceAndGradient(p, sdfDist, grad);

        if (sdfDist < _Thickness)
        {
            float gradLen = length(grad);
            float pushAmt = _Thickness - sdfDist;
            if (gradLen > 1e-6)
            {
                p += (grad / gradLen) * pushAmt;
            }
            else
            {
                p.y += pushAmt;
            }
        }
    }

    _PredPositions[i] = p;
}

// ─── Kernel 5: Commit ───────────────────────────────────────────

[numthreads(256, 1, 1)]
void ClothCommit(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _VertCount) return;
    if (_InvMass[i] <= 0.0) return;

    float3 pos  = _Positions[i];
    float3 pred = _PredPositions[i];
    float3 v    = (pred - pos) * _InvDt * _Damp;

    // Speed clamp
    float speedSq = dot(v, v);
    float maxSq   = _MaxSpeed * _MaxSpeed;
    if (speedSq > maxSq)
        v *= _MaxSpeed * rsqrt(speedSq);

    // SDF surface friction
    if (_UseSDF != 0)
    {
        float sdfDist;
        float3 grad;
        SDFDistanceAndGradient(pred, sdfDist, grad);

        if (sdfDist < _FrictionZone)
        {
            float gradLen = length(grad);
            if (gradLen > 1e-6)
            {
                float3 n = grad / gradLen;
                float vn = dot(v, n);
                if (vn < 0.0)
                {
                    float blend = 1.0 - saturate(sdfDist / _FrictionZone);
                    v -= n * (vn * blend);
                }
            }
        }
    }

    _Velocities[i] = v;
    _Positions[i]  = pred;
}
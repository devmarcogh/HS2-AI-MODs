// ============================================================================
// SDFBuildCompute.compute — GPU SDF builder (Optimized)
//
// Mejoras implementadas:
// - Desenrollado manual del K-Nearest insertion sort en variables escalares
//   para forzar el uso de registros de GPU, evitando indexación dinámica 
//   costosa en la memoria local (Groupshared/L1).
// ============================================================================

#pragma kernel BuildSDF
#pragma kernel SkinVertices
#pragma kernel SmoothSDF

// ─── Structs ────────────────────────────────────────────────────
struct VertexData
{
    float3 position;
    float  pad0;
    float3 normal;
    float  pad1;
};

struct BoneData
{
    int4   indices;
    float4 weights;
};

struct BindVertex
{
    float3 position;
    float  pad0;
    float3 normal;
    float  pad1;
};

// ─── Buffers ────────────────────────────────────────────────────

StructuredBuffer<VertexData>   _SkinnedVertices;
RWStructuredBuffer<float>      _SDFOutput;
StructuredBuffer<float>        _SDFInput;
RWStructuredBuffer<float>      _SDFSmoothed;
StructuredBuffer<BindVertex>   _BindVertices;
StructuredBuffer<BoneData>     _BoneDataBuf;
StructuredBuffer<float4x4>     _BoneMatrices;
RWStructuredBuffer<VertexData>  _SkinnedOutput;

// ─── Uniforms ───────────────────────────────────────────────────
int   _VertCount;
int   _ResX;
int   _ResY;
int   _ResZ;
float _OriginX;
float _OriginY;
float _OriginZ;
float _CellSize;
float _MaxDist;

// ─── BuildSDF kernel ────────────────────────────────────────────

[numthreads(4, 4, 4)]
void BuildSDF(uint3 id : SV_DispatchThreadID)
{
    int vx = (int)id.x;
    int vy = (int)id.y;
    int vz = (int)id.z;

    if (vx >= _ResX || vy >= _ResY || vz >= _ResZ)
        return;

    int vi = vz * _ResX * _ResY + vy * _ResX + vx;

    float3 voxelPos = float3(
        _OriginX + vx * _CellSize,
        _OriginY + vy * _CellSize,
        _OriginZ + vz * _CellSize);

    // ── K-nearest registers (Optimizado sin arreglos para forzar registros) ──
    float d0 = 1e30, d1 = 1e30, d2 = 1e30, d3 = 1e30;
    int   i0 = -1,   i1 = -1,   i2 = -1,   i3 = -1;

    for (int i = 0; i < _VertCount; i++)
    {
        float3 vp = _SkinnedVertices[i].position;
        float3 d_vec = voxelPos - vp;
        float dSq = dot(d_vec, d_vec);

        // Insertion sort explícito sobre registros
        if (dSq < d3)
        {
            if (dSq < d2)
            {
                if (dSq < d1)
                {
                    if (dSq < d0)
                    {
                        d3 = d2; i3 = i2;
                        d2 = d1; i2 = i1;
                        d1 = d0; i1 = i0;
                        d0 = dSq; i0 = i;
                    }
                    else
                    {
                        d3 = d2; i3 = i2;
                        d2 = d1; i2 = i1;
                        d1 = dSq; i1 = i;
                    }
                }
                else
                {
                    d3 = d2; i3 = i2;
                    d2 = dSq; i2 = i;
                }
            }
            else
            {
                d3 = dSq; i3 = i;
            }
        }
    }

    if (i0 < 0)
    {
        _SDFOutput[vi] = _MaxDist;
        return;
    }

    float dist = sqrt(d0);

    // ── Distance-weighted sign voting from K nearest ──
    float signAccum = 0.0;
    float epsilon = d0 * 0.01 + 1e-10;

    // Helper macro manual para no repetir el código del voto
    if (i0 >= 0) {
        float3 n = _SkinnedVertices[i0].normal;
        float3 v = voxelPos - _SkinnedVertices[i0].position;
        signAccum += dot(v, n) * (1.0 / (d0 + epsilon));
    }
    if (i1 >= 0) {
        float3 n = _SkinnedVertices[i1].normal;
        float3 v = voxelPos - _SkinnedVertices[i1].position;
        signAccum += dot(v, n) * (1.0 / (d1 + epsilon));
    }
    if (i2 >= 0) {
        float3 n = _SkinnedVertices[i2].normal;
        float3 v = voxelPos - _SkinnedVertices[i2].position;
        signAccum += dot(v, n) * (1.0 / (d2 + epsilon));
    }
    if (i3 >= 0) {
        float3 n = _SkinnedVertices[i3].normal;
        float3 v = voxelPos - _SkinnedVertices[i3].position;
        signAccum += dot(v, n) * (1.0 / (d3 + epsilon));
    }

    float sign = (signAccum >= 0.0) ? 1.0 : -1.0;
    _SDFOutput[vi] = dist * sign;
}

// ─── SkinVertices kernel ────────────────────────────────────────

[numthreads(64, 1, 1)]
void SkinVertices(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _VertCount) return;

    float3 bindP = _BindVertices[i].position;
    float3 bindN = _BindVertices[i].normal;

    int4   idx = _BoneDataBuf[i].indices;
    float4 w   = _BoneDataBuf[i].weights;

    float4 p4 = float4(bindP, 1.0);
    float4 n4 = float4(bindN, 0.0);
    
    float3 pos = float3(0, 0, 0);
    float3 nor = float3(0, 0, 0);

    if (w.x > 0.0)
    {
        pos += mul(_BoneMatrices[idx.x], p4).xyz * w.x;
        nor += mul(_BoneMatrices[idx.x], n4).xyz * w.x;
    }
    if (w.y > 0.0)
    {
        pos += mul(_BoneMatrices[idx.y], p4).xyz * w.y;
        nor += mul(_BoneMatrices[idx.y], n4).xyz * w.y;
    }
    if (w.z > 0.0)
    {
        pos += mul(_BoneMatrices[idx.z], p4).xyz * w.z;
        nor += mul(_BoneMatrices[idx.z], n4).xyz * w.z;
    }
    if (w.w > 0.0)
    {
        pos += mul(_BoneMatrices[idx.w], p4).xyz * w.w;
        nor += mul(_BoneMatrices[idx.w], n4).xyz * w.w;
    }

    float lenN = length(nor);
    nor = (lenN > 1e-6) ? (nor / lenN) : float3(0, 1, 0);

    VertexData result;
    result.position = pos;
    result.pad0     = 0;
    result.normal   = nor;
    result.pad1     = 0;

    _SkinnedOutput[i] = result;
}

// ─── SmoothSDF kernel ──────────────────────────────────────────

[numthreads(4, 4, 4)]
void SmoothSDF(uint3 id : SV_DispatchThreadID)
{
    int vx = (int)id.x;
    int vy = (int)id.y;
    int vz = (int)id.z;

    if (vx >= _ResX || vy >= _ResY || vz >= _ResZ)
        return;

    float sum    = 0.0;
    float wTotal = 0.0;
    int rxy = _ResX * _ResY;

    [unroll] for (int dz = -1; dz <= 1; dz++)
    [unroll] for (int dy = -1; dy <= 1; dy++)
    [unroll] for (int dx = -1; dx <= 1; dx++)
    {
        int nx = vx + dx;
        int ny = vy + dy;
        int nz = vz + dz;
        
        if (nx < 0 || nx >= _ResX || ny < 0 || ny >= _ResY || nz < 0 || nz >= _ResZ)
            continue;
            
        int manhattan = abs(dx) + abs(dy) + abs(dz);
        float w;
        if      (manhattan == 0) w = 8.0;
        else if (manhattan == 1) w = 4.0;
        else if (manhattan == 2) w = 2.0;
        else                     w = 1.0;

        int ni = nz * rxy + ny * _ResX + nx;
        sum    += _SDFInput[ni] * w;
        wTotal += w;
    }

    int vi = vz * rxy + vy * _ResX + vx;
    _SDFSmoothed[vi] = sum / wTotal;
}
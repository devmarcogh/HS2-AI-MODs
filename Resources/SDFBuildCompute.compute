// ============================================================================
// SDFBuildCompute.compute — GPU SDF builder for cloth body collision
//
// Three kernels:
//   1. SkinVertices  — 4-bone LBS on GPU (64 threads/group)
//   2. BuildSDF      — Per-voxel closest vertex + K-nearest sign voting
//   3. SmoothSDF     — 3×3×3 Gaussian blur to eliminate Voronoi-valley jitter
//
// The BuildSDF kernel uses distance-weighted normal voting from the K nearest
// vertices to determine inside/outside sign, instead of relying on a single
// vertex normal. This prevents sign flips from erratic proxy normals.
//
// The SmoothSDF pass then blurs the raw SDF, filling the valleys between
// Voronoi cells so the gradient field is smooth for XPBD collision response.
//
// Requires: DirectX 11 / Compute Shader 5.0
// ============================================================================

#pragma kernel BuildSDF
#pragma kernel SkinVertices
#pragma kernel SmoothSDF

// ─── Structs ────────────────────────────────────────────────────
struct VertexData
{
    float3 position;
    float  pad0;
    float3 normal;
    float  pad1;
};

struct BoneData
{
    int4   indices;
    float4 weights;
};

struct BindVertex
{
    float3 position;
    float  pad0;
    float3 normal;
    float  pad1;
};

// ─── Buffers ────────────────────────────────────────────────────

// BuildSDF kernel
StructuredBuffer<VertexData>   _SkinnedVertices;  // skinned world-space positions + normals
RWStructuredBuffer<float>      _SDFOutput;         // [totalVoxels] output (raw, pre-smooth)

// SmoothSDF kernel (ping-pong)
StructuredBuffer<float>        _SDFInput;          // input  for smoothing (reads raw)
RWStructuredBuffer<float>      _SDFSmoothed;       // output for smoothing (writes blurred)

// SkinVertices kernel
StructuredBuffer<BindVertex>   _BindVertices;      // rest-pose positions + normals
StructuredBuffer<BoneData>     _BoneDataBuf;       // per-vertex bone indices + weights
StructuredBuffer<float4x4>     _BoneMatrices;      // world-space skinning matrices
RWStructuredBuffer<VertexData>  _SkinnedOutput;    // output skinned positions + normals

// ─── Uniforms ───────────────────────────────────────────────────
int   _VertCount;
int   _ResX;
int   _ResY;
int   _ResZ;
float _OriginX;
float _OriginY;
float _OriginZ;
float _CellSize;
float _MaxDist;

// ─── BuildSDF kernel ────────────────────────────────────────────
// Dispatch: ceil(resX/4), ceil(resY/4), ceil(resZ/4)
//
// For each voxel: find the closest vertex for unsigned distance,
// then use distance-weighted normal voting from K nearest vertices
// to determine the sign. This avoids sign flips from a single
// bad normal (common with Dynamic Bone proxy meshes).
// ────────────────────────────────────────────────────────────────

// K-nearest for sign voting. 4 is a good balance:
// robust against 1-2 bad normals without too many registers.
#define K_NEAREST 4

[numthreads(4, 4, 4)]
void BuildSDF(uint3 id : SV_DispatchThreadID)
{
    int vx = (int)id.x;
    int vy = (int)id.y;
    int vz = (int)id.z;

    if (vx >= _ResX || vy >= _ResY || vz >= _ResZ)
        return;

    int vi = vz * _ResX * _ResY + vy * _ResX + vx;

    float3 voxelPos = float3(
        _OriginX + vx * _CellSize,
        _OriginY + vy * _CellSize,
        _OriginZ + vz * _CellSize);

    // ── Find K nearest vertices (insertion sort into small array) ──
    float kDistSq[K_NEAREST];
    int   kIdx[K_NEAREST];
    [unroll] for (int k = 0; k < K_NEAREST; k++)
    {
        kDistSq[k] = 1e30;
        kIdx[k]    = -1;
    }

    for (int i = 0; i < _VertCount; i++)
    {
        float3 vp = _SkinnedVertices[i].position;
        float3 d  = voxelPos - vp;
        float dSq = dot(d, d);

        // Insert into sorted K-nearest if closer than the farthest
        if (dSq < kDistSq[K_NEAREST - 1])
        {
            kDistSq[K_NEAREST - 1] = dSq;
            kIdx[K_NEAREST - 1]    = i;

            // Bubble towards front to maintain sorted order
            [unroll] for (int s = K_NEAREST - 1; s > 0; s--)
            {
                if (kDistSq[s] < kDistSq[s - 1])
                {
                    float tmpD  = kDistSq[s]; kDistSq[s] = kDistSq[s-1]; kDistSq[s-1] = tmpD;
                    int   tmpI  = kIdx[s];    kIdx[s]    = kIdx[s-1];    kIdx[s-1]    = tmpI;
                }
            }
        }
    }

    if (kIdx[0] < 0)
    {
        _SDFOutput[vi] = _MaxDist;
        return;
    }

    // ── Unsigned distance from closest vertex ──
    float dist = sqrt(kDistSq[0]);

    // ── Distance-weighted sign voting from K nearest ──
    // Weight = 1/dist² so closer vertices dominate the vote.
    // signAccum > 0 → outside, signAccum < 0 → inside.
    float signAccum = 0.0;
    float closestDSq = kDistSq[0];
    float epsilon = closestDSq * 0.01 + 1e-10; // prevent div-by-zero

    [unroll] for (int n = 0; n < K_NEAREST; n++)
    {
        if (kIdx[n] < 0) break;

        float3 toVoxel = voxelPos - _SkinnedVertices[kIdx[n]].position;
        float3 normal  = _SkinnedVertices[kIdx[n]].normal;
        float  vote    = dot(toVoxel, normal); // positive = outside
        float  weight  = 1.0 / (kDistSq[n] + epsilon);
        signAccum += vote * weight;
    }

    float sign = (signAccum >= 0.0) ? 1.0 : -1.0;
    _SDFOutput[vi] = dist * sign;
}

// ─── SkinVertices kernel ────────────────────────────────────────
// Optional GPU skinning. Dispatch: ceil(vertCount/64), 1, 1
[numthreads(64, 1, 1)]
void SkinVertices(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _VertCount) return;

    float3 bindP = _BindVertices[i].position;
    float3 bindN = _BindVertices[i].normal;

    int4   idx = _BoneDataBuf[i].indices;
    float4 w   = _BoneDataBuf[i].weights;

    float4 p4 = float4(bindP, 1.0);
    float4 n4 = float4(bindN, 0.0);

    float3 pos = float3(0, 0, 0);
    float3 nor = float3(0, 0, 0);

    if (w.x > 0.0)
    {
        pos += mul(_BoneMatrices[idx.x], p4).xyz * w.x;
        nor += mul(_BoneMatrices[idx.x], n4).xyz * w.x;
    }
    if (w.y > 0.0)
    {
        pos += mul(_BoneMatrices[idx.y], p4).xyz * w.y;
        nor += mul(_BoneMatrices[idx.y], n4).xyz * w.y;
    }
    if (w.z > 0.0)
    {
        pos += mul(_BoneMatrices[idx.z], p4).xyz * w.z;
        nor += mul(_BoneMatrices[idx.z], n4).xyz * w.z;
    }
    if (w.w > 0.0)
    {
        pos += mul(_BoneMatrices[idx.w], p4).xyz * w.w;
        nor += mul(_BoneMatrices[idx.w], n4).xyz * w.w;
    }

    float lenN = length(nor);
    nor = (lenN > 1e-6) ? (nor / lenN) : float3(0, 1, 0);

    VertexData result;
    result.position = pos;
    result.pad0     = 0;
    result.normal   = nor;
    result.pad1     = 0;

    _SkinnedOutput[i] = result;
}

// ─── SmoothSDF kernel ──────────────────────────────────────────
// 3×3×3 Gaussian blur to smooth the raw vertex-distance SDF.
// Eliminates Voronoi-valley jitter: the gradient field becomes
// continuous, so XPBD collision response won't oscillate when
// particles slide across vertex boundaries.
//
// Dispatch: ceil(resX/4), ceil(resY/4), ceil(resZ/4)
// Reads from _SDFInput, writes to _SDFSmoothed (ping-pong).
// ────────────────────────────────────────────────────────────────

[numthreads(4, 4, 4)]
void SmoothSDF(uint3 id : SV_DispatchThreadID)
{
    int vx = (int)id.x;
    int vy = (int)id.y;
    int vz = (int)id.z;

    if (vx >= _ResX || vy >= _ResY || vz >= _ResZ)
        return;

    // 3×3×3 Gaussian weights (σ ≈ 0.85, center-heavy to preserve detail)
    // Layout: center=0.125, face=0.0625, edge=0.03125, corner=0.015625
    // Total weight for normalization is computed on-the-fly (boundary voxels
    // skip out-of-bounds neighbors).

    float sum    = 0.0;
    float wTotal = 0.0;

    int rxy = _ResX * _ResY;

    [unroll] for (int dz = -1; dz <= 1; dz++)
    [unroll] for (int dy = -1; dy <= 1; dy++)
    [unroll] for (int dx = -1; dx <= 1; dx++)
    {
        int nx = vx + dx;
        int ny = vy + dy;
        int nz = vz + dz;

        if (nx < 0 || nx >= _ResX ||
            ny < 0 || ny >= _ResY ||
            nz < 0 || nz >= _ResZ)
            continue;

        // Manhattan distance → weight tier
        int manhattan = abs(dx) + abs(dy) + abs(dz);
        float w;
        if      (manhattan == 0) w = 8.0;  // center
        else if (manhattan == 1) w = 4.0;  // face neighbor
        else if (manhattan == 2) w = 2.0;  // edge neighbor
        else                     w = 1.0;  // corner neighbor

        int ni = nz * rxy + ny * _ResX + nx;
        sum    += _SDFInput[ni] * w;
        wTotal += w;
    }

    int vi = vz * rxy + vy * _ResX + vx;
    _SDFSmoothed[vi] = sum / wTotal;
}

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-managed-debug",
            "command": "dotnet",
            "type": "process",
            "args": [
                "msbuild",
                "${workspaceFolder}/StudioCharaEditor.sln",
                "/p:Configuration=Debug",
                "/t:Build",
                "/v:m"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "install-native-debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/Native/build",
                "--config", "Debug",
                "--target", "install"
            ],
            "problemMatcher": []
        },
        {
            "label": "Dev-Build-and-Deploy",
            "dependsOn": [
                "build-managed-debug",
                "install-native-debug"
            ],
            "dependsOrder": "parallel",
            "type": "shell",
            "command": "start \"\" \"D:/Documents/CAARP/StudioNEOV2.exe\"",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}